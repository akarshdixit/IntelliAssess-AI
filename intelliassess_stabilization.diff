+"""
+reporting package — enterprise DOCX report generation layer.
+
+Exposes the single stable entry point generate_docx() so callers use
+`from reporting import generate_docx` without coupling to the internal module
+layout (reporting/reporter.py). This is the mission-critical output path; it is
+designed to never raise (see reporter.generate_docx).
+
+reporter_old_backup.py is retained in this package as a legacy reference only.
+It is NOT imported anywhere and is not part of the active reporting pipeline.
+"""
+
+from reporting.reporter import generate_docx  # noqa: F401
+
+__all__ = ["generate_docx"]
