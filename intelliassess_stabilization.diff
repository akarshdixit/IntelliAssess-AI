+"""
+parsers package — deterministic scan parsing layer.
+
+Importing this package bootstraps the parser registry. Each concrete parser
+module self-registers (via parsers.registry.register) at import time, but
+*something* must import those modules for that to happen. This package __init__
+is that single bootstrap point.
+
+Design rationale:
+  - parsers/registry.py stays intentionally generic — it knows nothing about
+    which concrete parsers exist (its docstring promises "zero changes to
+    registry.py" to add a parser). The knowledge of which parsers to load lives
+    here instead. To add a new tool parser you add one line to _PARSER_MODULES.
+  - Graceful degradation: a parser module that fails to import is logged and
+    skipped rather than crashing the platform. Dispatch for that tool type then
+    falls back to an empty ParsedScanData (see parsers.registry.parse_file),
+    which is the correct bounded-failure behaviour.
+
+Public API re-exported for convenience:
+  parse_file, register, get_parser, list_registered_parsers
+"""
+
+from utils.logger import get_logger
+
+# Generic dispatch API first — no concrete-parser dependencies, so this is
+# always safe to import even if individual parsers later fail to load.
+from parsers.registry import (  # noqa: F401
+    parse_file,
+    register,
+    get_parser,
+    list_registered_parsers,
+)
+
+log = get_logger(__name__)
+
+# Concrete parser bootstrap. Each import triggers the parser's module-level
+# register() call. Explicit `import` statements (not importlib with string
+# names) are used deliberately so PyInstaller's static dependency analysis
+# bundles every parser into the EXE. Each import is isolated in its own
+# try/except so one broken parser cannot disable the others (graceful
+# degradation — dispatch for a missing tool type falls back to empty results).
+
+try:
+    from parsers import nmap_parser  # noqa: F401  (registers NmapParser)
+except Exception as exc:  # pragma: no cover - defensive bootstrap guard
+    log.error("parsers: failed to load nmap_parser — NMAP dispatch will fall "
+              "back to empty results. Cause: %s", exc, exc_info=True)
+
+try:
+    from parsers import httpx_parser  # noqa: F401  (registers HttpxParser)
+except Exception as exc:  # pragma: no cover - defensive bootstrap guard
+    log.error("parsers: failed to load httpx_parser — HTTPX dispatch will fall "
+              "back to empty results. Cause: %s", exc, exc_info=True)
+
+try:
+    from parsers import sslscan_parser  # noqa: F401  (registers SslscanParser)
+except Exception as exc:  # pragma: no cover - defensive bootstrap guard
+    log.error("parsers: failed to load sslscan_parser — SSLSCAN dispatch will "
+              "fall back to empty results. Cause: %s", exc, exc_info=True)
+
+log.debug("parsers package initialized — registered: %s", list_registered_parsers())
